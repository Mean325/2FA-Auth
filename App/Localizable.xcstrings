{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "settings.twoFA": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2FA 管理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2FA Management"
          }
        }
      }
    },
    "settings.twoFAHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用双重验证、智能复制与账号管理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable two-factor authentication, Smart Copy, and account management"
          }
        }
      }
    },
    "settings.twoFAEnabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable"
          }
        }
      }
    },
    "settings.smartCopy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能复制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Copy"
          }
        }
      }
    },
    "settings.smartCopyHint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动复制的验证码过期后，自动复制一次新的验证码，关闭悬浮弹窗后仍生效。期间复制其他内容会取消本次更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically copy a fresh code once the manually copied code expires, even when the popover is closed. Copying something else cancels the update."
          }
        }
      }
    },
  "settings.visibility": {
