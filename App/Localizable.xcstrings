  "camera.denied": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法访问摄像头，请在系统设置中允许钥记使用摄像头。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Camera access is denied. Allow camera access for Keymark in System Settings."
        }
      }
    }
