  "camera.scanDetail": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用电脑摄像头识别两步验证二维码"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Scan an authentication QR code with your Mac camera"
        }
      }
    }
  },
  "camera.scanHint": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "将二维码对准摄像头，识别成功后自动进入添加确认。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Point the camera at a QR code. A recognized code opens the account confirmation."
