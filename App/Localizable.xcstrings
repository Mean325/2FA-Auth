  "camera.failed": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法启动摄像头，请关闭其他占用摄像头的应用后重试。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The camera could not start. Close other apps using it and try again."
        }
      }
    }
